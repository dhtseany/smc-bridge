[Unit]
Description=SMC Bridge — SMC-Mixer to jack_mixer MIDI bridge

[Service]
Type=exec
WorkingDirectory=/ai/projects/smc_mixer_mac2cc
ExecStart=/usr/bin/python3 -m smc_bridge --headless
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
